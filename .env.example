# Aurora AI - Environment Variables Reference (PRD 10.2, 10.6, 21)
# Note: The web client (web/) is a static export with NO secrets.
# All sensitive credentials belong exclusively in the gateway worker environment.

# ==========================================
# GATEWAY (gateway/) - CLOUDFLARE WORKER
# ==========================================

# [SERVER-ONLY SECRETS - Never expose to client bundles]
# Set via 'npx wrangler secret put <KEY>'
HOSTED_PROVIDER_ACCOUNT_ID=your_cloudflare_account_id_here
HOSTED_PROVIDER_API_TOKEN=your_cloudflare_api_token_here

# [GATEWAY PUBLIC CONFIGURATION]
ALLOWED_ORIGINS=http://localhost:3000,https://aurora.example.com
HOSTED_PROVIDER_MODEL_ALLOWLIST=@cf/meta/llama-3-8b-instruct,@cf/meta/llama-3.1-8b-instruct,@cf/mistral/mistral-7b-instruct-v0.2
HOSTED_PROVIDER_DEFAULT_MODEL=@cf/meta/llama-3-8b-instruct
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
KILL_SWITCH=false

# ==========================================
# LOCAL RUNTIME (Ollama) - LOCAL COMPUTER
# ==========================================
# Configure in your operating system environment before starting Ollama:
# OLLAMA_ORIGINS="*"
